# [유지] 한글 폴더명 오류 방지용 Compose 프로젝트 이름
COMPOSE_PROJECT_NAME=monew

# [선택] DB 계정 이름이며, 변경 시 Compose의 헬스체크 계정도 수정하세요.
DB_USER=postgres

# [필수 입력] 작은따옴표 안의 예시를 사용할 DB 비밀번호로 교체하세요.
DB_PASSWORD=postgres

# 실제 비밀번호 입력 전 git rm --cached .env로 Git 추적을 해제하고 커밋하세요.
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=postgres
DB_USER=postgres
DB_PASSWORD=1234


#테스트 DB
ARTICLE_TEST_DATABASE_PASSWORD=1234